# Скопируйте в .env и впишите свои ключи. .env никому не отправлять.
OPENROUTER_API_KEY=
# Модели для чистки текста через запятую, пробуются по порядку.
# По умолчанию бесплатные; платный запас в конце — ~$0,01 за статью.
# OPENROUTER_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,deepseek/deepseek-v4-flash

# Telegram-бот: токен от @BotFather и ваш id (бот сам подскажет id при первом сообщении)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=

# Альтернатива OpenRouter — DeepSeek напрямую
# DEEPSEEK_API_KEY=

# Нужен только для --tts yandex
YANDEX_API_KEY=
# YANDEX_SPEED=1.0

# Сколько кусков озвучивать параллельно
# TTS_THREADS=4
